# This is a systemd service file.  Symlink it into into
# `/etc/systemd/system/` or `${HOME}/.config/systemd/user/`.
#
# ```
# $ sudo systemctl daemon-reload
# $ sudo systemctl enable $SERVICE
# $ sudo systemctl start $SERVICE # or reboot
# $ sudo systemctl status $SERVICE
# $ sudo journalctl -u $SERVICE -f -n 1000
# ```

[Unit]
Description=Garage Battery Controller
StartLimitIntervalSec=0

[Service]
Type=simple
Restart=always
RestartSec=60
User=seb

WorkingDirectory=/home/seb
ExecStart=/home/seb/.cargo/bin/garage-battery --config /home/seb/crispy-home-power/garage-battery/config.example.toml


[Install]
WantedBy=default.target
